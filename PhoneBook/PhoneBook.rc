// filter \n extension \n regkey \n regkey-name

// The IDR_MAINFRAME string doubles as the CSingleDocTemplate document
// string: title\ndocname\nfiltername\nfilterext\nregkey\nregkeyname
STRINGTABLE
BEGIN
    IDR_MAINFRAME           "PhoneBook\nPhoneBook\nPhoneBook\nPhone Book Files (*.pbk)\n.pbk\nPhoneBook.Document\nPhoneBook Document"
END

STRINGTABLE
BEGIN
    AFX_IDS_APP_TITLE       "PhoneBook"
    AFX_IDS_IDLEMESSAGE     "Ready"
END

STRINGTABLE
BEGIN
    ID_FILE_NEW             "Create a new phone book\nNew"
    ID_FILE_OPEN            "Open an existing phone book\nOpen"
    ID_FILE_SAVE            "Save the phone book\nSave"
    ID_FILE_SAVE_AS         "Save the phone book under a new name\nSave As"
    ID_APP_EXIT             "Quit the application\nExit"
    ID_APP_ABOUT            "Show program information\nAbout"
    ID_ENTRY_ADD            "Add a new phone book entry\nAdd Entry"
    ID_ENTRY_EDIT           "Edit the selected entry\nEdit Entry"
    ID_ENTRY_DELETE         "Delete the selected entry\nDelete Entry"
END

STRINGTABLE
BEGIN
    ID_INDICATOR_EXT        "EXT"
    ID_INDICATOR_CAPS       "CAP"
    ID_INDICATOR_NUM        "NUM"
    ID_INDICATOR_SCRL       "SCRL"
    ID_INDICATOR_OVR        "OVR"
    ID_INDICATOR_REC        "REC"
