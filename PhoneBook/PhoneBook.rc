#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
// Menu

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",               ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Entry"
    BEGIN
        MENUITEM "&Add...\tCtrl+A",             ID_ENTRY_ADD
        MENUITEM "&Edit...\tEnter",             ID_ENTRY_EDIT
        MENUITEM "&Delete\tDel",                ID_ENTRY_DELETE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About PhoneBook...",         ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
// Accelerator

IDR_MAINFRAME ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL
    "A",            ID_ENTRY_ADD,           VIRTKEY, CONTROL
    VK_DELETE,      ID_ENTRY_DELETE,        VIRTKEY
END


/////////////////////////////////////////////////////////////////////////////
// Dialog
//
// Requirement 3's Add/Edit dialog: Name edit, Sex combo, Phone edit.

IDD_ENTRYDLG DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Entry"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Name:",IDC_STATIC,7,10,40,8
    EDITTEXT        IDC_EDIT_NAME,55,8,138,14,ES_AUTOHSCROLL

    LTEXT           "Sex:",IDC_STATIC,7,30,40,8
    COMBOBOX        IDC_COMBO_SEX,55,28,80,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Phone Number:",IDC_STATIC,7,50,48,8
    EDITTEXT        IDC_EDIT_PHONE,55,48,138,14,ES_AUTOHSCROLL

    DEFPUSHBUTTON   "OK",IDOK,88,78,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,143,78,50,14
END

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PhoneBook"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "PhoneBook, Version 1.0",IDC_STATIC,14,14,150,8,SS_NOPREFIX
    LTEXT           "SDI phone book sample (MFC doc/view)",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END


